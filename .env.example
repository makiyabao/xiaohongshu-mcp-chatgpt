# Optional MCP-side authentication. Empty is intended only for a private loopback deployment.
# Set your own value locally; never commit the resulting .env.
AUTH_TOKEN=

# Container paths; these are not host-specific paths.
COOKIES_PATH=/app/data/cookies.json

# Optional browser settings. 0 means choose/persist a seed through the existing session logic.
XHS_FP_SEED=0
XHS_PROXY=

# Optional comma-separated account IDs protected from unfollow; configure your own IDs privately.
XHS_PROTECTED_USER_IDS=

# Tunnel credentials are independent of this MCP configuration and do not belong in this file.
